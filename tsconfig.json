{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/actions/*": ["./src/app/actions/*"],
      "@/blog/*": ["./src/features/blog/*"],
      "@/components/*": ["./src/features/common/components/*"],
      "@/contact/*": ["./src/features/contact/*"],
      "@/convex/*": ["./convex/*"],
      "@/db/*": ["./src/features/db/*"],
      "@/dtos/*": ["./src/features/common/dtos/*"],
      "@/hooks/*": ["./src/features/common/hooks/*"],
      "@/payment/*": ["./src/features/payment/*"],
      "@/product/*": ["./src/features/product/*"],
      "@/products/*": ["./src/features/products/*"],
      "@/providers/*": ["./src/providers/*"],
      "@/saved/*": ["./src/features/saved/*"],
      "@/store/*": ["./src/features/store/*"],
      "@/stores/*": ["./src/features/stores/*"],
      "@/types/*": ["./src/features/common/types/*"],
      "@/utils/*": ["./src/features/common/utils/*"],
      "@/videos/*": ["./src/features/videos/*"],
      "@/ui/*": ["./src/features/common/components/ui/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "convex/stores.js"
  ],
  "exclude": ["node_modules"]
}
